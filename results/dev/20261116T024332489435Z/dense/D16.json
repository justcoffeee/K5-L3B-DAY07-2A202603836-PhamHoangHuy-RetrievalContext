        },
        {
          "id": "dfe29fdd1b1fc2c1e55a629f7499f668",
          "text": "The builtin ExceptionGroup wraps a list of exception instances so that they can be raised together. It is an exception itself, so it can be caught like any other exception.",
          "source_id": "python-3.14-ch08",
          "source": "https://docs.python.org/3.14/tutorial/errors.html",
